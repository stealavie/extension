{
  "manifest_version": 3,
  "name": "YouTube Subtitle Generator",
  "version": "1.1",
  "description": "Tạo phụ đề tự động cho video YouTube.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}